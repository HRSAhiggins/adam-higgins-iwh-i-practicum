doctype html
html 
  head 
    title= title
    meta(name="viewport", content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
  body    
    h1= title
    pre= JSON.stringify(data, null, 2)
    .cards 
      each committee in data
        .card 
          h2.card__name #{committee.properties.name} #{committee.id}
          p.card__email #{committee.properties.code} #{committee.properties.status} #{committee.properties.type}