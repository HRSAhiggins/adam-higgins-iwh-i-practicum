doctype html
html 
  head 
    title= title
    meta(name="viewport", content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
  body   
    .page-container 
      .page-header
        h1= title
        a.button(href="/update-cobj") Add or Update Committee
      .table-container
        table
          thead
            tr
              th Name
              th Code
              th Type
          tbody
            each committee in data
              tr
                td= committee.properties.name
                td= committee.properties.code
                td= committee.properties.type